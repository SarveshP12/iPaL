# ── Application ──
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_NAME=iPaL-Backend
APP_VERSION=0.1.0

# ── Vector Database (Qdrant) ──
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=icici_docs
QDRANT_API_KEY=

# ── Embedding Model ──
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── LLM Provider ──
LLM_PROVIDER=google
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.0-flash

# ── PostgreSQL Database ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ipal_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ipal_db

# ── Redis Cache ──
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ──
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Document Ingestion ──
DOCUMENT_STORAGE_PATH=./data/documents
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=30

# ── Logging ──
LOG_LEVEL=INFO